// schema.prisma — Plataforma Orbitalis

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMs
// ─────────────────────────────────────────

enum UsuarioTipo {
  admin
  tecnico
  cliente
}

enum OsStatus {
  aberta
  agendada
  em_andamento
  concluida
  cancelada
}

enum OsOrigem {
  manual_admin
  preventiva_automatica
  portal_cliente
  orcamento_aprovado
}

enum AlertaTipo {
  os_atrasada
  os_sem_atualizacao
  equipamento_reincidente
  contrato_vencendo
  plano_vencendo
  mttr_critico
}

enum AlertaSeveridade {
  info
  aviso
  critico
}

enum OsTipo {
  preventiva
  corretiva
  nao_se_aplica   // O.S. que não é manutenção (ex.: visita técnica, reunião)
}

enum OrcamentoStatus {
  rascunho
  enviado
  aprovado
  rejeitado
  expirado
}

enum OsItemStatus {
  pendente
  concluido
}

enum ConviteTipo {
  tecnico
  cliente
  admin
}

// ─────────────────────────────────────────
// empresas  (multi-tenancy — cada empresa é um tenant)
// ─────────────────────────────────────────
model Empresa {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(100)
  nomeEmpresa  String   @map("nome_empresa") @db.VarChar(255)
  nomeFantasia String?  @map("nome_fantasia") @db.VarChar(255)
  plano        String   @default("basico") @db.VarChar(50)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("empresas")
}

// ─────────────────────────────────────────
// convites  (links de acesso para técnicos e clientes)
// ─────────────────────────────────────────
model Convite {
  id        String      @id @default(uuid()) @db.Uuid
  token     String      @unique @default(uuid()) @db.Uuid
  tipo      ConviteTipo
  email     String?     @db.VarChar(255)
  clienteId String?     @map("cliente_id") @db.Uuid
  expiresAt DateTime    @map("expires_at")
  usadoEm   DateTime?   @map("usado_em")
  criadoEm  DateTime    @default(now()) @map("criado_em")
  empresaId String?     @map("empresa_id") @db.Uuid
  // Convite de usuário do escritório: perfil e módulos liberados
  perfilAcesso String?  @map("perfil_acesso") @db.VarChar(30)
  permissoes   String[] @default([])

  @@map("convites")
}

// ─────────────────────────────────────────
// usuarios
// ─────────────────────────────────────────
model Usuario {
  id            String      @id @default(uuid()) @db.Uuid
  // único por empresa (índice parcial em lower(email)+empresa_id, criado na migration): o mesmo e-mail pode existir em empresas diferentes
  email         String      @db.VarChar(255)
  senhaHash     String      @map("senha_hash") @db.VarChar(255)
  tipo          UsuarioTipo
  nome          String?     @db.VarChar(150)
  telefone      String?     @db.VarChar(20)
  especialidade String?     @db.VarChar(100)
  crea          String?     @db.VarChar(20)
  dataCriacao   DateTime    @default(now()) @map("data_criacao")
  empresaId     String?     @map("empresa_id") @db.Uuid
  // Avisos da agenda: quantos minutos antes de um evento a pessoa quer ser notificada (até 3)
  avisosAgenda  Int[]       @default([30]) @map("avisos_agenda")
  // Equipe do escritório (tipo admin): null/'administrador' = acesso total; senão só os módulos de `permissoes`
  perfilAcesso  String?     @map("perfil_acesso") @db.VarChar(30)
  permissoes    String[]    @default([])
  // true depois que um administrador redefine a senha: a pessoa deve trocá-la no primeiro acesso
  senhaProvisoria Boolean   @default(false) @map("senha_provisoria")

  cliente                        Cliente?
  ordensComoTecnico              OrdemServico[]    @relation("TecnicoOrdens")
  ordensComoAuxiliar             OrdemServicoAuxiliar[] @relation("TecnicoAuxiliar")
  pushAssinaturas                PushAssinatura[]
  planosComoTecnico              PlanoManutencao[] @relation("TecnicoPlanos")
  configuracaoEmpresaResponsavel ConfiguracaoEmpresa?
  orcamentosCriados              Orcamento[]       @relation("OrcamentoCriadoPor")
  eventosComoTecnico             EventoAgenda[]    @relation("EventoTecnico")

  @@index([email])
  @@map("usuarios")
}

// ─────────────────────────────────────────
// clientes  (soft delete via deletedAt)
// ─────────────────────────────────────────
model Cliente {
  id           String    @id @default(uuid()) @db.Uuid
  usuarioId    String?   @unique @map("usuario_id") @db.Uuid
  documento    String?   @db.VarChar(14)
  razaoSocial  String    @map("razao_social") @db.VarChar(255)
  nomeFantasia String?   @map("nome_fantasia") @db.VarChar(255)
  endereco     String    @db.Text
  // Outros endereços do cliente [{ id, rotulo, endereco }]: Casa, Loja, Trabalho…
  enderecosExtras Json   @default("[]") @map("enderecos_extras")
  telefone     String?   @db.VarChar(20)
  celular      String?   @db.VarChar(20)
  email        String?   @db.VarChar(255)
  cidade       String?   @db.VarChar(100)
  uf           String?   @db.VarChar(2)
  deletedAt    DateTime? @map("deleted_at")
  empresaId    String?   @map("empresa_id") @db.Uuid

  usuario          Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  ambientes        Ambiente[]
  planosManutencao PlanoManutencao[]
  contratos        Contrato[]
  orcamentos       Orcamento[]
  eventos          EventoAgenda[]

  @@unique([empresaId, documento])
  @@index([empresaId])
  @@map("clientes")
}

// ─────────────────────────────────────────
// ambientes  (soft delete via deletedAt)
// ─────────────────────────────────────────
model Ambiente {
  id                 String    @id @default(uuid()) @db.Uuid
  clienteId          String    @map("cliente_id") @db.Uuid
  nome               String    @db.VarChar(100)
  metrosQuadrados    Decimal   @map("metros_quadrados") @db.Decimal(10, 2)
  capacidadeTermica  String    @map("capacidade_termica") @db.VarChar(50)
  localizacaoInterna String    @map("localizacao_interna") @db.Text
  deletedAt          DateTime? @map("deleted_at")
  empresaId          String?   @map("empresa_id") @db.Uuid

  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  equipamentos  Equipamento[]
  ordensServico OrdemServico[]
  orcamentos    Orcamento[]

  @@index([empresaId])
  @@map("ambientes")
}

// ─────────────────────────────────────────
// equipamentos  (soft delete via deletedAt)
// ─────────────────────────────────────────
model Equipamento {
  id                 String    @id @default(uuid()) @db.Uuid
  ambienteId         String    @map("ambiente_id") @db.Uuid
  codigoQr           String    @unique @map("codigo_qr") @db.VarChar(50)
  nome               String    @db.VarChar(100)
  marca              String    @db.VarChar(100)
  modelo             String?   @db.VarChar(100)
  numeroSerie        String?   @map("numero_serie") @db.VarChar(100)
  tipoEquipamento    String    @map("tipo_equipamento") @db.VarChar(100)
  potencia           String?   @db.VarChar(50)
  dataInstalacao     DateTime? @map("data_instalacao")
  condicao           String?   @db.VarChar(20)
  diagnosticoInicial String?   @map("diagnostico_inicial") @db.Text
  valorAquisicao     Decimal?  @map("valor_aquisicao") @db.Decimal(10, 2)
  deletedAt          DateTime? @map("deleted_at")
  empresaId          String?   @map("empresa_id") @db.Uuid

  ambiente         Ambiente                @relation(fields: [ambienteId], references: [id])
  itensOs          OrdemServicoItem[]
  planoConfigs     PlanoEquipamentoConfig[]

  @@index([codigoQr])
  @@index([empresaId])
  @@map("equipamentos")
}

// ─────────────────────────────────────────
// modelos_checklist
// ─────────────────────────────────────────
model ModeloChecklist {
  id            String  @id @default(uuid()) @db.Uuid
  nome          String  @db.VarChar(150)
  itens         Json
  // Caso de uso do checklist: preventiva/corretiva (null = serve para qualquer tipo)
  tipo          OsTipo?
  // Tipo de serviço específico (null = serve para qualquer serviço)
  tipoServicoId String? @map("tipo_servico_id") @db.Uuid
  empresaId     String? @map("empresa_id") @db.Uuid

  tipoServico  TipoServico?             @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  planoConfigs PlanoEquipamentoConfig[]
  orcamentos   Orcamento[]

  @@index([tipo])
  @@map("modelos_checklist")
}

// ─────────────────────────────────────────
// planos_manutencao  (§US05)
// Um plano por cliente cobre todos os ambientes/equipamentos.
// Gera uma O.S. por ambiente por ciclo.
// ─────────────────────────────────────────
model PlanoManutencao {
  id             String    @id @default(uuid()) @db.Uuid
  clienteId      String    @map("cliente_id") @db.Uuid
  tecnicoId      String?   @map("tecnico_id") @db.Uuid
  frequenciaDias Int       @map("frequencia_dias")
  ativo          Boolean   @default(true)
  proximaGeracao DateTime  @map("proxima_geracao")
  ultimaGeracao  DateTime? @map("ultima_geracao")
  dataFim        DateTime? @map("data_fim")
  empresaId      String?   @map("empresa_id") @db.Uuid

  tipoServicoId  String?   @map("tipo_servico_id") @db.Uuid
  // Contrato que este plano atende (opcional): permite acompanhar o consumo de O.S. do contrato
  contratoId     String?   @map("contrato_id") @db.Uuid
  // Visitas (limpezas/inspeções) por equipamento incluídas no plano: limita a geração de O.S.
  // null = plano antigo, sem limite (só a data limite vale)
  visitasPrevistas Int?    @map("visitas_previstas")
  visitasGeradas   Int     @default(0) @map("visitas_geradas")
  // Como agrupar as O.S. de cada visita: 'cliente' (uma O.S. com todos os equipamentos), 'ambiente'
  // (uma por ambiente) ou null = padrão da empresa. maxEquipamentosPorOs divide visitas grandes.
  agrupamento          String? @map("agrupamento") @db.VarChar(10)
  maxEquipamentosPorOs Int?    @map("max_equipamentos_por_os")
  // Horário padrão da visita (HH:MM), aplicado às O.S. geradas
  horaInicio           String? @map("hora_inicio") @db.VarChar(5)
  horaFim              String? @map("hora_fim") @db.VarChar(5)

  cliente            Cliente                  @relation(fields: [clienteId], references: [id])
  contrato           Contrato?                @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  tecnico            Usuario?                 @relation("TecnicoPlanos", fields: [tecnicoId], references: [id])
  tipoServico        TipoServico?             @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  equipamentosConfig PlanoEquipamentoConfig[]
  ordensServico      OrdemServico[]

  @@index([proximaGeracao, ativo])
  @@index([contratoId])
  @@map("planos_manutencao")
}

// ─────────────────────────────────────────
// plano_equipamento_config
// Mapeamento equipamento → checklist específico dentro do plano.
// ─────────────────────────────────────────
model PlanoEquipamentoConfig {
  id                String  @id @default(uuid()) @db.Uuid
  planoId           String  @map("plano_id") @db.Uuid
  equipamentoId     String  @map("equipamento_id") @db.Uuid
  modeloChecklistId String? @map("modelo_checklist_id") @db.Uuid

  plano           PlanoManutencao  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  equipamento     Equipamento      @relation(fields: [equipamentoId], references: [id])
  modeloChecklist ModeloChecklist? @relation(fields: [modeloChecklistId], references: [id], onDelete: SetNull)

  @@unique([planoId, equipamentoId])
  @@map("plano_equipamento_config")
}

// ─────────────────────────────────────────
// ordens_servico
// ─────────────────────────────────────────
model OrdemServico {
  id                String    @id @default(uuid()) @db.Uuid
  numero            Int       @default(autoincrement())
  // Cancelamento documentado: motivo (código fixo), explicação e quando
  cancelamentoMotivo  String?   @map("cancelamento_motivo") @db.VarChar(30)
  cancelamentoDetalhe String?   @map("cancelamento_detalhe") @db.Text
  canceladaEm         DateTime? @map("cancelada_em")
  ambienteId        String    @map("ambiente_id") @db.Uuid
  planoId           String?   @map("plano_id") @db.Uuid
  tecnicoId         String?   @map("tecnico_id") @db.Uuid
  status            OsStatus
  tipo              OsTipo   @default(corretiva)
  origem            OsOrigem
  assinaturaBase64  String?   @map("assinatura_base64") @db.Text
  tipoGas           String?   @map("tipo_gas") @db.VarChar(20)
  quantidadeGasGramas Decimal? @map("quantidade_gas_gramas") @db.Decimal(8, 1)
  observacoesGerais String?   @map("observacoes_gerais") @db.Text
  dataAgendamento   DateTime  @map("data_agendamento")
  dataInicio        DateTime? @map("data_inicio")
  dataConclusao     DateTime? @map("data_conclusao")
  valorMaoObra          Decimal? @map("valor_mao_obra") @db.Decimal(10, 2)
  valorPecas            Decimal? @map("valor_pecas") @db.Decimal(10, 2)
  tipoServicoId         String?  @map("tipo_servico_id") @db.Uuid
  // Outros tipos de serviço da mesma O.S. (o principal, em tipoServicoId, define cor, sigla e checklist sugerido)
  tiposServicoExtras    String[] @default([]) @map("tipos_servico_extras") @db.Uuid
  // Endereço do cliente onde o serviço é feito (id dentro de clientes.enderecos_extras); vazio = endereço principal
  enderecoId            String?  @map("endereco_id") @db.VarChar(40)
  horaInicio            String?  @map("hora_inicio") @db.VarChar(5)
  horaFim               String?  @map("hora_fim") @db.VarChar(5)
  // Nome de quem recebeu o serviço no cliente (junto da assinatura)
  recebidoPor           String?  @map("recebido_por") @db.VarChar(120)
  // Observação geral do técnico sobre a O.S. (vale também para visitas sem equipamento) e quem a registrou
  observacoesTecnico    String?  @map("observacoes_tecnico") @db.Text
  observacoesTecnicoPor String?  @map("observacoes_tecnico_por") @db.VarChar(120)
  observacoesTecnicoEm  DateTime? @map("observacoes_tecnico_em")
  dataCriacao           DateTime @default(now()) @map("data_criacao")
  empresaId             String?  @map("empresa_id") @db.Uuid

  ambiente     Ambiente                        @relation(fields: [ambienteId], references: [id])
  plano        PlanoManutencao?                @relation(fields: [planoId], references: [id], onDelete: SetNull)
  tecnico      Usuario?                        @relation("TecnicoOrdens", fields: [tecnicoId], references: [id])
  tipoServico  TipoServico?                    @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  itens            OrdemServicoItem[]
  conflitos        AuditoriaConflitoSincronizacao[]
  orcamento        Orcamento?
  eventos          EventoAgenda[]
  dias             OrdemServicoDia[]
  historico        OrdemServicoHistorico[]
  auxiliares       OrdemServicoAuxiliar[]
  fotos            OrdemServicoFoto[]

  @@index([status])
  @@index([empresaId])
  // Numeração sequencial por empresa (contadores_empresa); o default é só um respaldo
  @@unique([empresaId, numero])
  @@map("ordens_servico")
}

// ─────────────────────────────────────────
// log_auditoria — quem fez o quê (alterações e logins)
// ─────────────────────────────────────────
model LogAuditoria {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String?  @map("empresa_id") @db.Uuid
  usuarioId    String?  @map("usuario_id") @db.Uuid
  usuarioNome  String?  @map("usuario_nome") @db.VarChar(150)
  usuarioEmail String?  @map("usuario_email") @db.VarChar(255)
  usuarioTipo  String?  @map("usuario_tipo") @db.VarChar(20)
  acao         String   @db.VarChar(20)
  metodo       String?  @db.VarChar(10)
  rota         String?  @db.VarChar(255)
  entidade     String?  @db.VarChar(50)
  entidadeId   String?  @map("entidade_id") @db.VarChar(60)
  descricao    String   @db.VarChar(255)
  detalhes     Json?
  status       Int?
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@index([empresaId, criadoEm(sort: Desc)])
  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@map("log_auditoria")
}

// ─────────────────────────────────────────
// ordem_servico_historico — mudanças de status (quando ocorreu, quem registrou)
// ─────────────────────────────────────────
model OrdemServicoHistorico {
  id             String   @id @default(uuid()) @db.Uuid
  ordemServicoId String   @map("ordem_servico_id") @db.Uuid
  deStatus       String?  @map("de_status") @db.VarChar(20)
  paraStatus     String   @map("para_status") @db.VarChar(20)
  ocorridoEm     DateTime @map("ocorrido_em")
  registradoEm   DateTime @default(now()) @map("registrado_em")
  usuarioId      String?  @map("usuario_id") @db.Uuid
  usuarioNome    String?  @map("usuario_nome") @db.VarChar(150)
  observacao     String?  @db.Text

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@map("ordem_servico_historico")
}

// ─────────────────────────────────────────
// ordem_servico_itens
// ─────────────────────────────────────────
model OrdemServicoItem {
  id                  String       @id @default(uuid()) @db.Uuid
  ordemServicoId      String       @map("ordem_servico_id") @db.Uuid
  equipamentoId       String       @map("equipamento_id") @db.Uuid
  statusItem          OsItemStatus @default(pendente) @map("status_item")
  checklistSnapshot   Json         @map("checklist_snapshot")
  observacoesTecnicas String?      @map("observacoes_tecnicas") @db.Text

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  equipamento  Equipamento  @relation(fields: [equipamentoId], references: [id])
  fotos        OrdemServicoFoto[]

  @@map("ordem_servico_itens")
}

// ─────────────────────────────────────────
// tipos_servico  (nomenclatura e cores por tipo de serviço)
// ─────────────────────────────────────────
model TipoServico {
  id              String   @id @default(uuid()) @db.Uuid
  sigla           String   @db.VarChar(5)
  nome            String   @db.VarChar(100)
  corHex          String   @map("cor_hex") @db.VarChar(7)
  duracaoMinutos  Int      @default(60) @map("duracao_minutos")
  // Visita (avaliação antes do serviço): entra no funil visitas → orçamentos → serviços fechados
  ehVisita        Boolean  @default(false) @map("eh_visita")
  valorPadrao     Decimal? @map("valor_padrao") @db.Decimal(10, 2)
  ativo           Boolean  @default(true)
  sistema         Boolean  @default(false)
  // Conta no relatório de atendimentos da agenda? Desmarcado para feriados, lembretes etc.
  entraNoRelatorio Boolean @default(true) @map("entra_no_relatorio")
  empresaId       String?  @map("empresa_id") @db.Uuid

  ordensServico    OrdemServico[]
  planos           PlanoManutencao[]
  modelosChecklist ModeloChecklist[]
  orcamentos       Orcamento[]
  eventos          EventoAgenda[]

  @@unique([empresaId, sigla])
  @@map("tipos_servico")
}

// ─────────────────────────────────────────
// configuracao_empresa  (white-label / branding)
// ─────────────────────────────────────────
model ConfiguracaoEmpresa {
  id           String   @id @default(uuid()) @db.Uuid
  nomeEmpresa  String   @map("nome_empresa") @db.VarChar(255)
  nomeFantasia String?  @map("nome_fantasia") @db.VarChar(255)
  logoUrl      String?  @map("logo_url") @db.VarChar(512)
  corPrimaria  String?  @map("cor_primaria") @db.VarChar(7)
  cnpj         String?  @db.VarChar(18)
  telefone     String?  @db.VarChar(30)
  endereco     String?  @db.VarChar(255)
  // Contato exibido nos documentos (O.S., laudos) e instruções fixas impressas na O.S. para o técnico
  email        String?  @db.VarChar(255)
  site         String?  @db.VarChar(255)
  instrucoesOs String?  @map("instrucoes_os") @db.Text
  // Agrupamento padrão das O.S. geradas pelos planos preventivos: 'cliente' ou 'ambiente'
  agrupamentoOsPadrao String @default("cliente") @map("agrupamento_os_padrao") @db.VarChar(10)
  // Localização da empresa (base para feriados estaduais/municipais e documentos)
  cidade       String?  @db.VarChar(120)
  uf           String?  @db.VarChar(2)
  codigoIbge   String?  @map("codigo_ibge") @db.VarChar(7)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")


  // Responsável técnico para relatórios PMOC
  responsavelTecnicoId     String?   @unique @map("responsavel_tecnico_id") @db.Uuid
  responsavelTecnico       Usuario?  @relation(fields: [responsavelTecnicoId], references: [id], onDelete: SetNull)

  // Thresholds de confiabilidade (MTTR/MTBF)
  mttrLimiteHoras          Int?      @map("mttr_limite_horas")
  mtbfLimiteDias           Int?      @map("mtbf_limite_dias")
  custoHoraParada          Decimal?  @map("custo_hora_parada") @db.Decimal(10, 2)
  empresaId                String?   @map("empresa_id") @db.Uuid

  @@map("configuracao_empresa")
}

// ─────────────────────────────────────────
// contratos
// ─────────────────────────────────────────
model Contrato {
  id             String    @id @default(uuid()) @db.Uuid
  clienteId      String    @map("cliente_id") @db.Uuid
  descricao      String    @db.VarChar(255)
  valorMensal    Decimal?  @map("valor_mensal") @db.Decimal(10, 2)
  vigenciaInicio DateTime  @map("vigencia_inicio")
  vigenciaFim    DateTime  @map("vigencia_fim")
  numOsIncluidas Int?      @map("num_os_incluidas")
  observacoes    String?   @db.Text
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  empresaId      String?   @map("empresa_id") @db.Uuid

  // Renovação: o contrato novo aponta para o anterior, que fica no histórico
  renovadoDeId   String?   @map("renovado_de_id") @db.Uuid

  cliente    Cliente           @relation(fields: [clienteId], references: [id])
  planos     PlanoManutencao[]
  renovadoDe Contrato?         @relation("RenovacaoContrato", fields: [renovadoDeId], references: [id], onDelete: SetNull)
  renovacoes Contrato[]        @relation("RenovacaoContrato")

  @@index([clienteId, vigenciaFim])
  @@index([renovadoDeId])
  @@map("contratos")
}

// ─────────────────────────────────────────
// alerta_config  (configuração dos limiares)
// ─────────────────────────────────────────
model AlertaConfig {
  id                      String @id @default(uuid()) @db.Uuid
  osSemAtualizacaoDias    Int     @default(3)  @map("os_sem_atualizacao_dias")
  equipamentoCorretivasMes Int    @default(3)  @map("equipamento_corretivas_mes")
  contratoVencendoDias    Int     @default(30) @map("contrato_vencendo_dias")
  planoVencendoDias       Int     @default(30) @map("plano_vencendo_dias")
  empresaId               String? @map("empresa_id") @db.Uuid

  @@map("alerta_config")
}

// ─────────────────────────────────────────
// alerta_ocorrencias
// ─────────────────────────────────────────
model AlertaOcorrencia {
  id           String           @id @default(uuid()) @db.Uuid
  tipo         AlertaTipo
  severidade   AlertaSeveridade
  titulo       String           @db.VarChar(255)
  descricao    String           @db.Text
  referenciaId String?          @map("referencia_id") @db.VarChar(255)
  resolvido    Boolean          @default(false)
  criadoEm    DateTime          @default(now()) @map("criado_em")
  resolvidoEm DateTime?         @map("resolvido_em")
  empresaId   String?           @map("empresa_id") @db.Uuid

  @@index([resolvido, criadoEm])
  @@map("alerta_ocorrencias")
}

model AuditoriaConflitoSincronizacao {
  id               String   @id @default(uuid()) @db.Uuid
  ordemServicoId   String   @map("ordem_servico_id") @db.Uuid
  payloadRejeitado Json     @map("payload_rejeitado")
  criadoEm        DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id])

  @@map("auditoria_conflitos_sincronizacao")
}

// ─────────────────────────────────────────
// orcamentos  (proposta comercial)
// ─────────────────────────────────────────
model Orcamento {
  id           String          @id @default(uuid()) @db.Uuid
  numero       Int             @default(autoincrement())
  status       OrcamentoStatus @default(rascunho)
  titulo       String          @db.VarChar(255)
  validadeDias Int             @default(30) @map("validade_dias")
  observacoes  String?         @db.Text
  tokenPublico String          @unique @default(uuid()) @map("token_publico") @db.Uuid

  clienteId   String   @map("cliente_id") @db.Uuid
  cliente     Cliente  @relation(fields: [clienteId], references: [id])

  // Como a O.S. será gerada quando o orçamento for aprovado
  ambienteId        String? @map("ambiente_id") @db.Uuid
  tipoOs            OsTipo  @default(corretiva) @map("tipo_os")
  tipoServicoId     String? @map("tipo_servico_id") @db.Uuid
  modeloChecklistId String? @map("modelo_checklist_id") @db.Uuid
  // O.S. gerada a partir deste orçamento (preenchida na aprovação)
  ordemServicoId    String? @unique @map("ordem_servico_id") @db.Uuid
  // Visita (O.S.) que originou este orçamento — base do funil de conversão (sem relation Prisma: só referência)
  visitaOrigemId    String? @map("visita_origem_id") @db.Uuid

  ambiente        Ambiente?        @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  tipoServico     TipoServico?     @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  modeloChecklist ModeloChecklist? @relation(fields: [modeloChecklistId], references: [id], onDelete: SetNull)
  ordemServico    OrdemServico?    @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  criadoPorId String?  @map("criado_por_id") @db.Uuid
  criadoPor   Usuario? @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  itens        OrcamentoItem[]

  criadoEm    DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  aprovadoEm  DateTime? @map("aprovado_em")
  rejeitadoEm DateTime? @map("rejeitado_em")
  empresaId   String?   @map("empresa_id") @db.Uuid

  @@index([clienteId])
  @@index([status])
  // Numeração sequencial por empresa (contadores_empresa); o default é só um respaldo
  @@unique([empresaId, numero])
  @@index([visitaOrigemId])
  @@map("orcamentos")
}

model OrcamentoItem {
  id            String    @id @default(uuid()) @db.Uuid
  descricao     String    @db.VarChar(255)
  quantidade    Decimal   @default(1) @db.Decimal(10, 3)
  unidade       String    @default("un") @db.VarChar(20)
  precoUnitario Decimal   @map("preco_unitario") @db.Decimal(10, 2)
  // 'servico' (mão de obra) ou 'peca' — alimenta valorMaoObra/valorPecas da O.S. gerada
  categoria     String    @default("servico") @db.VarChar(10)

  orcamentoId String    @map("orcamento_id") @db.Uuid
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@map("orcamento_itens")
}

// ─────────────────────────────────────────
// Suprimentos: fornecedores, produtos (com estoque) e catálogo de serviços
// ─────────────────────────────────────────
model Fornecedor {
  id                String   @id @default(uuid()) @db.Uuid
  empresaId         String?  @map("empresa_id") @db.Uuid
  numero            Int      @default(autoincrement())
  // 'J' pessoa jurídica · 'F' pessoa física
  tipoPessoa        String   @default("J") @map("tipo_pessoa") @db.VarChar(1)
  razaoSocial       String   @map("razao_social") @db.VarChar(255)
  nomeFantasia      String?  @map("nome_fantasia") @db.VarChar(255)
  cpfCnpj           String?  @map("cpf_cnpj") @db.VarChar(18)
  inscricaoEstadual String?  @map("inscricao_estadual") @db.VarChar(30)
  email             String?  @db.VarChar(255)
  telefone          String?  @db.VarChar(30)
  celular           String?  @db.VarChar(30)
  contato           String?  @db.VarChar(120)
  cep               String?  @db.VarChar(9)
  logradouro        String?  @db.VarChar(255)
  numeroEndereco    String?  @map("numero_endereco") @db.VarChar(20)
  complemento       String?  @db.VarChar(120)
  bairro            String?  @db.VarChar(120)
  cidade            String?  @db.VarChar(120)
  uf                String?  @db.VarChar(2)
  observacoes       String?  @db.Text
  ativo             Boolean  @default(true)
  deletedAt         DateTime? @map("deleted_at")
  criadoEm          DateTime @default(now()) @map("criado_em")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em")

  produtos   Produto[]
  movimentos MovimentoEstoque[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@map("fornecedores")
}

model Produto {
  id                  String   @id @default(uuid()) @db.Uuid
  empresaId           String?  @map("empresa_id") @db.Uuid
  numero              Int      @default(autoincrement())
  nome                String   @db.VarChar(255)
  descricao           String?  @db.Text
  codigoInterno       String?  @map("codigo_interno") @db.VarChar(60)
  codigoBarras        String?  @map("codigo_barras") @db.VarChar(60)
  marca               String?  @db.VarChar(100)
  categoria           String?  @db.VarChar(80)
  unidade             String   @default("un") @db.VarChar(20)
  ncm                 String?  @db.VarChar(10)
  precoCusto          Decimal  @default(0) @map("preco_custo") @db.Decimal(12, 2)
  precoVenda          Decimal  @default(0) @map("preco_venda") @db.Decimal(12, 2)
  // Se desmarcado (ex.: item sob encomenda), não há saldo nem bloqueio de saída
  controlaEstoque     Boolean  @default(true) @map("controla_estoque")
  saldo               Decimal  @default(0) @db.Decimal(14, 3)
  estoqueMinimo       Decimal  @default(0) @map("estoque_minimo") @db.Decimal(14, 3)
  localizacao         String?  @db.VarChar(120)
  estoqueMaximo       Decimal  @default(0) @map("estoque_maximo") @db.Decimal(14, 3)
  cest                String?  @db.VarChar(10)
  origem              Int?
  pesoBruto           Decimal  @default(0) @map("peso_bruto") @db.Decimal(10, 3)
  pesoLiquido         Decimal  @default(0) @map("peso_liquido") @db.Decimal(10, 3)
  comissaoPercentual  Decimal  @default(0) @map("comissao_percentual") @db.Decimal(5, 2)
  // Custo final = precoCusto + despesas acessórias + outras despesas (calculado na tela)
  despesasAcessorias  Decimal  @default(0) @map("despesas_acessorias") @db.Decimal(12, 2)
  outrasDespesas      Decimal  @default(0) @map("outras_despesas") @db.Decimal(12, 2)
  // dimensões em metros
  largura             Decimal  @default(0) @db.Decimal(10, 3)
  altura              Decimal  @default(0) @db.Decimal(10, 3)
  comprimento         Decimal  @default(0) @db.Decimal(10, 3)
  codBeneficio        String?  @map("cod_beneficio") @db.VarChar(20)
  fornecedorPadraoId  String?  @map("fornecedor_padrao_id") @db.Uuid
  ativo               Boolean  @default(true)
  deletedAt           DateTime? @map("deleted_at")
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  fornecedorPadrao Fornecedor?        @relation(fields: [fornecedorPadraoId], references: [id], onDelete: SetNull)
  movimentos       MovimentoEstoque[]
  inventarioItens  InventarioItem[]

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@map("produtos")
}

// Histórico de estoque: cada linha é uma entrada, saída ou ajuste; `delta` é com sinal (+ entra, − sai)
model MovimentoEstoque {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String?  @map("empresa_id") @db.Uuid
  produtoId      String   @map("produto_id") @db.Uuid
  // 'entrada' | 'saida' | 'ajuste'
  tipo           String   @db.VarChar(10)
  // compra, saldo_inicial, devolucao, uso_os, uso_orcamento, perda, ajuste_inventario, outro
  motivo         String   @db.VarChar(30)
  delta          Decimal  @db.Decimal(14, 3)
  saldoApos      Decimal  @map("saldo_apos") @db.Decimal(14, 3)
  custoUnitario  Decimal? @map("custo_unitario") @db.Decimal(12, 2)
  fornecedorId   String?  @map("fornecedor_id") @db.Uuid
  // Nº da nota fiscal ou documento de origem
  documento      String?  @db.VarChar(60)
  // Origem (referências sem relation Prisma, como visitaOrigemId)
  ordemServicoId String?  @map("ordem_servico_id") @db.Uuid
  orcamentoId    String?  @map("orcamento_id") @db.Uuid
  observacao     String?  @db.Text
  usuarioId      String?  @map("usuario_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em")

  produto    Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  fornecedor Fornecedor? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)

  @@index([empresaId, criadoEm])
  @@index([produtoId, criadoEm])
  @@map("movimentos_estoque")
}

// Catálogo de serviços para orçamento e nota (o "tipo de serviço" da agenda é outra coisa: cor, sigla e duração)
model Servico {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String?  @map("empresa_id") @db.Uuid
  numero        Int      @default(autoincrement())
  nome          String   @db.VarChar(255)
  descricao     String?  @db.Text
  unidade       String   @default("un") @db.VarChar(20)
  valor         Decimal  @default(0) @db.Decimal(12, 2)
  // Código do serviço (ex.: importado de outro sistema); único por empresa quando preenchido
  codigo        String?  @db.VarChar(60)
  valorCusto    Decimal  @default(0) @map("valor_custo") @db.Decimal(12, 2)
  comissaoPercentual Decimal @default(0) @map("comissao_percentual") @db.Decimal(5, 2)
  atividadeServico String? @map("atividade_servico") @db.VarChar(120)
  nbs           String?  @db.VarChar(20)
  // Tipo de serviço da agenda usado ao gerar a O.S. a partir de um orçamento aprovado
  tipoServicoId String?  @map("tipo_servico_id") @db.Uuid
  ativo         Boolean  @default(true)
  deletedAt     DateTime? @map("deleted_at")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@map("servicos")
}

// Inventário: conferência física do estoque. Ao abrir, congela o saldo do sistema de cada produto;
// ao concluir, os itens contados viram ajustes no estoque (com histórico).
model Inventario {
  id            String    @id @default(uuid()) @db.Uuid
  empresaId     String?   @map("empresa_id") @db.Uuid
  numero        Int       @default(autoincrement())
  titulo        String    @db.VarChar(120)
  // 'aberto' | 'concluido' | 'cancelado'
  status        String    @default("aberto") @db.VarChar(12)
  // Contagem cega: a tela e a folha não mostram o saldo do sistema para quem conta
  contagemCega  Boolean   @default(false) @map("contagem_cega")
  // Recorte usado na abertura (só informativo)
  filtroCategoria   String? @map("filtro_categoria") @db.VarChar(80)
  filtroLocalizacao String? @map("filtro_localizacao") @db.VarChar(120)
  observacoes   String?   @db.Text
  criadoPorId   String?   @map("criado_por_id") @db.Uuid
  concluidoPorId String?  @map("concluido_por_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em")
  concluidoEm   DateTime? @map("concluido_em")

  itens InventarioItem[]

  @@unique([empresaId, numero])
  @@index([empresaId, criadoEm])
  @@map("inventarios")
}

model InventarioItem {
  id           String    @id @default(uuid()) @db.Uuid
  empresaId    String?   @map("empresa_id") @db.Uuid
  inventarioId String    @map("inventario_id") @db.Uuid
  produtoId    String    @map("produto_id") @db.Uuid
  // Saldo do sistema no momento da abertura
  saldoSistema Decimal   @map("saldo_sistema") @db.Decimal(14, 3)
  // null = ainda não contado
  contado      Decimal?  @db.Decimal(14, 3)
  contadoEm    DateTime? @map("contado_em")
  contadoPorId String?   @map("contado_por_id") @db.Uuid
  observacao   String?   @db.VarChar(500)
  // Variação aplicada ao estoque na conclusão (null = não houve ajuste)
  ajusteAplicado Decimal? @map("ajuste_aplicado") @db.Decimal(14, 3)

  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  produto    Produto    @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([inventarioId, produtoId])
  @@index([empresaId])
  @@map("inventario_itens")
}

// ─────────────────────────────────────────
// contadores_empresa  (numeração sequencial por empresa: O.S., orçamentos)
// ─────────────────────────────────────────
model ContadorEmpresa {
  empresaId String @map("empresa_id") @db.Uuid
  nome      String @db.VarChar(40)
  valor     Int    @default(0)

  @@id([empresaId, nome])
  @@map("contadores_empresa")
}

// ─────────────────────────────────────────
// eventos_agenda  (agenda própria do Orbitalis)
// Toda O.S. com data tem um evento (1:1, sincronizado); eventos avulsos
// (reunião, treinamento, lembrete) não têm ordemServicoId.
// inicio/fim são instantes (UTC); a exibição usa America/Sao_Paulo.
// ─────────────────────────────────────────
model EventoAgenda {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String?  @map("empresa_id") @db.Uuid
  titulo         String   @db.VarChar(200)
  descricao      String?  @db.Text
  local          String?  @db.Text
  inicio         DateTime
  fim            DateTime
  diaInteiro     Boolean  @default(false) @map("dia_inteiro")
  cor            String?  @db.VarChar(7)
  // true quando alguém editou título/descrição/local à mão: a O.S. deixa de sobrescrevê-los
  personalizado  Boolean  @default(false)
  ordemServicoId String?  @map("ordem_servico_id") @db.Uuid
  // O.S. de vários dias: cada dia de trabalho tem o seu evento
  osDiaId        String?  @map("os_dia_id") @db.Uuid
  tipoServicoId  String?  @map("tipo_servico_id") @db.Uuid
  // Outros tipos de serviço do mesmo evento (ex.: VT + MC); o principal acima define cor e relatórios
  tiposExtrasIds String[] @default([]) @map("tipos_extras_ids") @db.Uuid
  tecnicoId      String?  @map("tecnico_id") @db.Uuid
  clienteId      String?  @map("cliente_id") @db.Uuid
  // Avisos deste evento: avisar=false desliga; lista vazia = usar os avisos padrão de quem é avisado
  avisar         Boolean  @default(true)
  avisosMinutos  Int[]    @default([]) @map("avisos_minutos")
  // Eventos criados juntos por uma repetição compartilham a série (editar/excluir "este, seguintes ou todos")
  serieId        String?  @map("serie_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  ordemServico OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  osDia        OrdemServicoDia? @relation(fields: [osDiaId], references: [id], onDelete: Cascade)
  tipoServico  TipoServico?  @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  tecnico      Usuario?      @relation("EventoTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)
  cliente      Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([empresaId, inicio])
  @@index([tecnicoId])
  @@index([serieId])
  @@index([ordemServicoId])
  @@map("eventos_agenda")
}

// ─────────────────────────────────────────
// ordem_servico_dias — dias de trabalho de uma O.S. que dura mais de um dia
// ─────────────────────────────────────────
model OrdemServicoDia {
  id             String   @id @default(uuid()) @db.Uuid
  ordemServicoId String   @map("ordem_servico_id") @db.Uuid
  data           DateTime @db.Date
  horaInicio     String?  @map("hora_inicio") @db.VarChar(5)
  horaFim        String?  @map("hora_fim") @db.VarChar(5)
  empresaId      String?  @map("empresa_id") @db.Uuid

  ordemServico OrdemServico   @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  eventos      EventoAgenda[]

  @@unique([ordemServicoId, data])
  @@index([empresaId])
  @@map("ordem_servico_dias")
}


// ─────────────────────────────────────────
// feriados_empresa
// Feriados que a empresa cadastra (municipais, estaduais, recessos próprios).
// Os nacionais não ficam aqui: são calculados pela API. `recorrente` repete todo ano
// no mesmo dia/mês. `origem` deixa espaço para importadores (ex.: 'manual' | 'importado').
// ─────────────────────────────────────────
enum TipoFeriado {
  municipal
  estadual
  personalizado
}

model FeriadoEmpresa {
  id         String      @id @default(uuid()) @db.Uuid
  empresaId  String?     @map("empresa_id") @db.Uuid
  data       DateTime    @db.Date
  nome       String      @db.VarChar(150)
  tipo       TipoFeriado
  recorrente Boolean     @default(false)
  origem     String      @default("manual") @db.VarChar(30)
  criadoEm   DateTime    @default(now()) @map("criado_em")

  @@unique([empresaId, data, nome])
  @@index([empresaId, data])
  @@map("feriados_empresa")
}


// ─────────────────────────────────────────
// Técnicos auxiliares de uma O.S. (veem e preenchem junto com o responsável)
// ─────────────────────────────────────────
model OrdemServicoAuxiliar {
  id             String  @id @default(uuid()) @db.Uuid
  ordemServicoId String  @map("ordem_servico_id") @db.Uuid
  tecnicoId      String  @map("tecnico_id") @db.Uuid
  empresaId      String? @map("empresa_id") @db.Uuid

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tecnico      Usuario      @relation("TecnicoAuxiliar", fields: [tecnicoId], references: [id], onDelete: Cascade)

  @@unique([ordemServicoId, tecnicoId], map: "ordem_servico_auxiliares_os_tecnico_key")
  @@index([tecnicoId])
  @@index([empresaId])
  @@map("ordem_servico_auxiliares")
}

// ─────────────────────────────────────────
// Fotos da execução (JPEG já reduzido no aparelho). momento: antes | depois | problema | outra
// ─────────────────────────────────────────
model OrdemServicoFoto {
  id              String   @id @default(uuid()) @db.Uuid
  ordemServicoId  String   @map("ordem_servico_id") @db.Uuid
  itemId          String?  @map("item_id") @db.Uuid
  checklistItemId String?  @map("checklist_item_id") @db.VarChar(60)
  momento         String   @default("outra") @db.VarChar(10)
  legenda         String?  @db.VarChar(200)
  mime            String   @default("image/jpeg") @db.VarChar(40)
  dados           Bytes
  criadoPor       String?  @map("criado_por") @db.Uuid
  criadoEm        DateTime @default(now()) @map("criado_em")
  empresaId       String?  @map("empresa_id") @db.Uuid

  ordemServico OrdemServico      @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  item         OrdemServicoItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([ordemServicoId])
  @@index([empresaId])
  @@map("ordem_servico_fotos")
}

// ─────────────────────────────────────────
// Avisos no celular (Web Push): um registro por aparelho
// ─────────────────────────────────────────
model PushAssinatura {
  id        String   @id @default(uuid()) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  criadoEm  DateTime @default(now()) @map("criado_em")
  empresaId String?  @map("empresa_id") @db.Uuid

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([empresaId])
  @@map("push_assinaturas")
}

model PushConfig {
  id           Int    @id @default(1)
  chavePublica String @map("chave_publica")
  chavePrivada String @map("chave_privada")

  @@map("push_config")
}

// Central de avisos de cada usuário (histórico do que foi enviado por push)
model AvisoUsuario {
  id        String    @id @default(uuid()) @db.Uuid
  empresaId String?   @map("empresa_id") @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  titulo    String    @db.VarChar(200)
  corpo     String    @db.Text
  url       String?   @db.VarChar(300)
  lidoEm    DateTime? @map("lido_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")

  @@index([usuarioId, criadoEm])
  @@index([empresaId])
  @@map("avisos_usuario")
}


// ─────────────────────────────────────────
// Capacidade de horas: jornada semanal (empresa ou técnico) e ajustes por data
// ─────────────────────────────────────────
// tecnicoId nulo = jornada padrão da empresa. `minutos` tem 7 posições (domingo a sábado).
model JornadaSemanal {
  id           String   @id @default(uuid()) @db.Uuid
  empresaId    String?  @map("empresa_id") @db.Uuid
  tecnicoId    String?  @map("tecnico_id") @db.Uuid
  minutos      Int[]
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@index([empresaId])
  @@index([tecnicoId])
  @@map("jornadas_semanais")
}

// Exceção de um técnico num dia: 0 = folga/férias; outro valor = jornada daquele dia (ex.: meio período)
model JornadaAjuste {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String?  @map("empresa_id") @db.Uuid
  tecnicoId String   @map("tecnico_id") @db.Uuid
  data      DateTime @db.Date
  minutos   Int
  motivo    String?  @db.VarChar(120)
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@unique([tecnicoId, data])
  @@index([empresaId])
  @@map("jornada_ajustes")
}

// Markup padrão da empresa: categoria '' = regra geral; demais = regra do grupo de produtos.
// Preço de venda = custo final × (1 + percentual/100)
model MarkupRegra {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String?  @map("empresa_id") @db.Uuid
  categoria  String   @default("") @db.VarChar(80)
  percentual Decimal  @default(0) @db.Decimal(7, 2)
  criadoEm   DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@unique([empresaId, categoria])
  @@index([empresaId])
  @@map("markup_regras")
}
