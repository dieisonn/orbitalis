// schema.prisma — Plataforma Orbitalis

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMs
// ─────────────────────────────────────────

enum UsuarioTipo {
  admin
  tecnico
  cliente
}

enum OsStatus {
  aberta
  agendada
  em_andamento
  concluida
  cancelada
}

enum OsOrigem {
  manual_admin
  preventiva_automatica
  portal_cliente
  orcamento_aprovado
}

enum AlertaTipo {
  os_atrasada
  os_sem_atualizacao
  equipamento_reincidente
  contrato_vencendo
  plano_vencendo
  mttr_critico
}

enum AlertaSeveridade {
  info
  aviso
  critico
}

enum OsTipo {
  preventiva
  corretiva
  nao_se_aplica   // O.S. que não é manutenção (ex.: visita técnica, reunião)
}

enum OrcamentoStatus {
  rascunho
  enviado
  aprovado
  rejeitado
  expirado
}

enum OsItemStatus {
  pendente
  concluido
}

enum ConviteTipo {
  tecnico
  cliente
}

// ─────────────────────────────────────────
// empresas  (multi-tenancy — cada empresa é um tenant)
// ─────────────────────────────────────────
model Empresa {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(100)
  nomeEmpresa  String   @map("nome_empresa") @db.VarChar(255)
  nomeFantasia String?  @map("nome_fantasia") @db.VarChar(255)
  plano        String   @default("basico") @db.VarChar(50)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("empresas")
}

// ─────────────────────────────────────────
// convites  (links de acesso para técnicos e clientes)
// ─────────────────────────────────────────
model Convite {
  id        String      @id @default(uuid()) @db.Uuid
  token     String      @unique @default(uuid()) @db.Uuid
  tipo      ConviteTipo
  email     String?     @db.VarChar(255)
  clienteId String?     @map("cliente_id") @db.Uuid
  expiresAt DateTime    @map("expires_at")
  usadoEm   DateTime?   @map("usado_em")
  criadoEm  DateTime    @default(now()) @map("criado_em")
  empresaId String?     @map("empresa_id") @db.Uuid

  @@map("convites")
}

// ─────────────────────────────────────────
// usuarios
// ─────────────────────────────────────────
model Usuario {
  id            String      @id @default(uuid()) @db.Uuid
  email         String      @unique @db.VarChar(255)
  senhaHash     String      @map("senha_hash") @db.VarChar(255)
  tipo          UsuarioTipo
  nome          String?     @db.VarChar(150)
  telefone      String?     @db.VarChar(20)
  especialidade String?     @db.VarChar(100)
  crea          String?     @db.VarChar(20)
  dataCriacao   DateTime    @default(now()) @map("data_criacao")
  empresaId     String?     @map("empresa_id") @db.Uuid
  // Avisos da agenda: quantos minutos antes de um evento a pessoa quer ser notificada (até 3)
  avisosAgenda  Int[]       @default([30]) @map("avisos_agenda")

  cliente                        Cliente?
  ordensComoTecnico              OrdemServico[]    @relation("TecnicoOrdens")
  planosComoTecnico              PlanoManutencao[] @relation("TecnicoPlanos")
  configuracaoEmpresaResponsavel ConfiguracaoEmpresa?
  orcamentosCriados              Orcamento[]       @relation("OrcamentoCriadoPor")
  eventosComoTecnico             EventoAgenda[]    @relation("EventoTecnico")

  @@map("usuarios")
}

// ─────────────────────────────────────────
// clientes  (soft delete via deletedAt)
// ─────────────────────────────────────────
model Cliente {
  id           String    @id @default(uuid()) @db.Uuid
  usuarioId    String?   @unique @map("usuario_id") @db.Uuid
  documento    String?   @db.VarChar(14)
  razaoSocial  String    @map("razao_social") @db.VarChar(255)
  nomeFantasia String?   @map("nome_fantasia") @db.VarChar(255)
  endereco     String    @db.Text
  telefone     String?   @db.VarChar(20)
  celular      String?   @db.VarChar(20)
  email        String?   @db.VarChar(255)
  cidade       String?   @db.VarChar(100)
  uf           String?   @db.VarChar(2)
  deletedAt    DateTime? @map("deleted_at")
  empresaId    String?   @map("empresa_id") @db.Uuid

  usuario          Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  ambientes        Ambiente[]
  planosManutencao PlanoManutencao[]
  contratos        Contrato[]
  orcamentos       Orcamento[]
  eventos          EventoAgenda[]

  @@unique([empresaId, documento])
  @@index([empresaId])
  @@map("clientes")
}

// ─────────────────────────────────────────
// ambientes  (soft delete via deletedAt)
// ─────────────────────────────────────────
model Ambiente {
  id                 String    @id @default(uuid()) @db.Uuid
  clienteId          String    @map("cliente_id") @db.Uuid
  nome               String    @db.VarChar(100)
  metrosQuadrados    Decimal   @map("metros_quadrados") @db.Decimal(10, 2)
  capacidadeTermica  String    @map("capacidade_termica") @db.VarChar(50)
  localizacaoInterna String    @map("localizacao_interna") @db.Text
  deletedAt          DateTime? @map("deleted_at")
  empresaId          String?   @map("empresa_id") @db.Uuid

  cliente       Cliente        @relation(fields: [clienteId], references: [id])
  equipamentos  Equipamento[]
  ordensServico OrdemServico[]
  orcamentos    Orcamento[]

  @@index([empresaId])
  @@map("ambientes")
}

// ─────────────────────────────────────────
// equipamentos  (soft delete via deletedAt)
// ─────────────────────────────────────────
model Equipamento {
  id                 String    @id @default(uuid()) @db.Uuid
  ambienteId         String    @map("ambiente_id") @db.Uuid
  codigoQr           String    @unique @map("codigo_qr") @db.VarChar(50)
  nome               String    @db.VarChar(100)
  marca              String    @db.VarChar(100)
  modelo             String?   @db.VarChar(100)
  numeroSerie        String?   @map("numero_serie") @db.VarChar(100)
  tipoEquipamento    String    @map("tipo_equipamento") @db.VarChar(100)
  potencia           String?   @db.VarChar(50)
  dataInstalacao     DateTime? @map("data_instalacao")
  condicao           String?   @db.VarChar(20)
  diagnosticoInicial String?   @map("diagnostico_inicial") @db.Text
  valorAquisicao     Decimal?  @map("valor_aquisicao") @db.Decimal(10, 2)
  deletedAt          DateTime? @map("deleted_at")
  empresaId          String?   @map("empresa_id") @db.Uuid

  ambiente         Ambiente                @relation(fields: [ambienteId], references: [id])
  itensOs          OrdemServicoItem[]
  planoConfigs     PlanoEquipamentoConfig[]

  @@index([codigoQr])
  @@index([empresaId])
  @@map("equipamentos")
}

// ─────────────────────────────────────────
// modelos_checklist
// ─────────────────────────────────────────
model ModeloChecklist {
  id            String  @id @default(uuid()) @db.Uuid
  nome          String  @db.VarChar(150)
  itens         Json
  // Caso de uso do checklist: preventiva/corretiva (null = serve para qualquer tipo)
  tipo          OsTipo?
  // Tipo de serviço específico (null = serve para qualquer serviço)
  tipoServicoId String? @map("tipo_servico_id") @db.Uuid
  empresaId     String? @map("empresa_id") @db.Uuid

  tipoServico  TipoServico?             @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  planoConfigs PlanoEquipamentoConfig[]
  orcamentos   Orcamento[]

  @@index([tipo])
  @@map("modelos_checklist")
}

// ─────────────────────────────────────────
// planos_manutencao  (§US05)
// Um plano por cliente cobre todos os ambientes/equipamentos.
// Gera uma O.S. por ambiente por ciclo.
// ─────────────────────────────────────────
model PlanoManutencao {
  id             String    @id @default(uuid()) @db.Uuid
  clienteId      String    @map("cliente_id") @db.Uuid
  tecnicoId      String?   @map("tecnico_id") @db.Uuid
  frequenciaDias Int       @map("frequencia_dias")
  ativo          Boolean   @default(true)
  proximaGeracao DateTime  @map("proxima_geracao")
  ultimaGeracao  DateTime? @map("ultima_geracao")
  dataFim        DateTime? @map("data_fim")
  empresaId      String?   @map("empresa_id") @db.Uuid

  tipoServicoId  String?   @map("tipo_servico_id") @db.Uuid
  // Contrato que este plano atende (opcional): permite acompanhar o consumo de O.S. do contrato
  contratoId     String?   @map("contrato_id") @db.Uuid
  // Visitas (limpezas/inspeções) por equipamento incluídas no plano: limita a geração de O.S.
  // null = plano antigo, sem limite (só a data limite vale)
  visitasPrevistas Int?    @map("visitas_previstas")
  visitasGeradas   Int     @default(0) @map("visitas_geradas")
  // Como agrupar as O.S. de cada visita: 'cliente' (uma O.S. com todos os equipamentos), 'ambiente'
  // (uma por ambiente) ou null = padrão da empresa. maxEquipamentosPorOs divide visitas grandes.
  agrupamento          String? @map("agrupamento") @db.VarChar(10)
  maxEquipamentosPorOs Int?    @map("max_equipamentos_por_os")
  // Horário padrão da visita (HH:MM), aplicado às O.S. geradas
  horaInicio           String? @map("hora_inicio") @db.VarChar(5)
  horaFim              String? @map("hora_fim") @db.VarChar(5)

  cliente            Cliente                  @relation(fields: [clienteId], references: [id])
  contrato           Contrato?                @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  tecnico            Usuario?                 @relation("TecnicoPlanos", fields: [tecnicoId], references: [id])
  tipoServico        TipoServico?             @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  equipamentosConfig PlanoEquipamentoConfig[]
  ordensServico      OrdemServico[]

  @@index([proximaGeracao, ativo])
  @@index([contratoId])
  @@map("planos_manutencao")
}

// ─────────────────────────────────────────
// plano_equipamento_config
// Mapeamento equipamento → checklist específico dentro do plano.
// ─────────────────────────────────────────
model PlanoEquipamentoConfig {
  id                String  @id @default(uuid()) @db.Uuid
  planoId           String  @map("plano_id") @db.Uuid
  equipamentoId     String  @map("equipamento_id") @db.Uuid
  modeloChecklistId String? @map("modelo_checklist_id") @db.Uuid

  plano           PlanoManutencao  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  equipamento     Equipamento      @relation(fields: [equipamentoId], references: [id])
  modeloChecklist ModeloChecklist? @relation(fields: [modeloChecklistId], references: [id], onDelete: SetNull)

  @@unique([planoId, equipamentoId])
  @@map("plano_equipamento_config")
}

// ─────────────────────────────────────────
// ordens_servico
// ─────────────────────────────────────────
model OrdemServico {
  id                String    @id @default(uuid()) @db.Uuid
  numero            Int       @default(autoincrement())
  ambienteId        String    @map("ambiente_id") @db.Uuid
  planoId           String?   @map("plano_id") @db.Uuid
  tecnicoId         String?   @map("tecnico_id") @db.Uuid
  status            OsStatus
  tipo              OsTipo   @default(corretiva)
  origem            OsOrigem
  assinaturaBase64  String?   @map("assinatura_base64") @db.Text
  tipoGas           String?   @map("tipo_gas") @db.VarChar(20)
  quantidadeGasGramas Decimal? @map("quantidade_gas_gramas") @db.Decimal(8, 1)
  observacoesGerais String?   @map("observacoes_gerais") @db.Text
  dataAgendamento   DateTime  @map("data_agendamento")
  dataInicio        DateTime? @map("data_inicio")
  dataConclusao     DateTime? @map("data_conclusao")
  valorMaoObra          Decimal? @map("valor_mao_obra") @db.Decimal(10, 2)
  valorPecas            Decimal? @map("valor_pecas") @db.Decimal(10, 2)
  tipoServicoId         String?  @map("tipo_servico_id") @db.Uuid
  horaInicio            String?  @map("hora_inicio") @db.VarChar(5)
  horaFim               String?  @map("hora_fim") @db.VarChar(5)
  dataCriacao           DateTime @default(now()) @map("data_criacao")
  empresaId             String?  @map("empresa_id") @db.Uuid

  ambiente     Ambiente                        @relation(fields: [ambienteId], references: [id])
  plano        PlanoManutencao?                @relation(fields: [planoId], references: [id], onDelete: SetNull)
  tecnico      Usuario?                        @relation("TecnicoOrdens", fields: [tecnicoId], references: [id])
  tipoServico  TipoServico?                    @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  itens            OrdemServicoItem[]
  conflitos        AuditoriaConflitoSincronizacao[]
  orcamento        Orcamento?
  evento           EventoAgenda?

  @@index([status])
  @@index([empresaId])
  // Numeração sequencial por empresa (contadores_empresa); o default é só um respaldo
  @@unique([empresaId, numero])
  @@map("ordens_servico")
}

// ─────────────────────────────────────────
// ordem_servico_itens
// ─────────────────────────────────────────
model OrdemServicoItem {
  id                  String       @id @default(uuid()) @db.Uuid
  ordemServicoId      String       @map("ordem_servico_id") @db.Uuid
  equipamentoId       String       @map("equipamento_id") @db.Uuid
  statusItem          OsItemStatus @default(pendente) @map("status_item")
  checklistSnapshot   Json         @map("checklist_snapshot")
  observacoesTecnicas String?      @map("observacoes_tecnicas") @db.Text

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  equipamento  Equipamento  @relation(fields: [equipamentoId], references: [id])

  @@map("ordem_servico_itens")
}

// ─────────────────────────────────────────
// tipos_servico  (nomenclatura e cores por tipo de serviço)
// ─────────────────────────────────────────
model TipoServico {
  id              String   @id @default(uuid()) @db.Uuid
  sigla           String   @db.VarChar(5)
  nome            String   @db.VarChar(100)
  corHex          String   @map("cor_hex") @db.VarChar(7)
  duracaoMinutos  Int      @default(60) @map("duracao_minutos")
  valorPadrao     Decimal? @map("valor_padrao") @db.Decimal(10, 2)
  ativo           Boolean  @default(true)
  sistema         Boolean  @default(false)
  // Conta no relatório de atendimentos da agenda? Desmarcado para feriados, lembretes etc.
  entraNoRelatorio Boolean @default(true) @map("entra_no_relatorio")
  empresaId       String?  @map("empresa_id") @db.Uuid

  ordensServico    OrdemServico[]
  planos           PlanoManutencao[]
  modelosChecklist ModeloChecklist[]
  orcamentos       Orcamento[]
  eventos          EventoAgenda[]

  @@unique([empresaId, sigla])
  @@map("tipos_servico")
}

// ─────────────────────────────────────────
// configuracao_empresa  (white-label / branding)
// ─────────────────────────────────────────
model ConfiguracaoEmpresa {
  id           String   @id @default(uuid()) @db.Uuid
  nomeEmpresa  String   @map("nome_empresa") @db.VarChar(255)
  nomeFantasia String?  @map("nome_fantasia") @db.VarChar(255)
  logoUrl      String?  @map("logo_url") @db.VarChar(512)
  corPrimaria  String?  @map("cor_primaria") @db.VarChar(7)
  cnpj         String?  @db.VarChar(18)
  telefone     String?  @db.VarChar(30)
  endereco     String?  @db.VarChar(255)
  // Contato exibido nos documentos (O.S., laudos) e instruções fixas impressas na O.S. para o técnico
  email        String?  @db.VarChar(255)
  site         String?  @db.VarChar(255)
  instrucoesOs String?  @map("instrucoes_os") @db.Text
  // Agrupamento padrão das O.S. geradas pelos planos preventivos: 'cliente' ou 'ambiente'
  agrupamentoOsPadrao String @default("cliente") @map("agrupamento_os_padrao") @db.VarChar(10)
  // Localização da empresa (base para feriados estaduais/municipais e documentos)
  cidade       String?  @db.VarChar(120)
  uf           String?  @db.VarChar(2)
  codigoIbge   String?  @map("codigo_ibge") @db.VarChar(7)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")


  // Responsável técnico para relatórios PMOC
  responsavelTecnicoId     String?   @unique @map("responsavel_tecnico_id") @db.Uuid
  responsavelTecnico       Usuario?  @relation(fields: [responsavelTecnicoId], references: [id], onDelete: SetNull)

  // Thresholds de confiabilidade (MTTR/MTBF)
  mttrLimiteHoras          Int?      @map("mttr_limite_horas")
  mtbfLimiteDias           Int?      @map("mtbf_limite_dias")
  custoHoraParada          Decimal?  @map("custo_hora_parada") @db.Decimal(10, 2)
  empresaId                String?   @map("empresa_id") @db.Uuid

  @@map("configuracao_empresa")
}

// ─────────────────────────────────────────
// contratos
// ─────────────────────────────────────────
model Contrato {
  id             String    @id @default(uuid()) @db.Uuid
  clienteId      String    @map("cliente_id") @db.Uuid
  descricao      String    @db.VarChar(255)
  valorMensal    Decimal?  @map("valor_mensal") @db.Decimal(10, 2)
  vigenciaInicio DateTime  @map("vigencia_inicio")
  vigenciaFim    DateTime  @map("vigencia_fim")
  numOsIncluidas Int?      @map("num_os_incluidas")
  observacoes    String?   @db.Text
  ativo          Boolean   @default(true)
  criadoEm       DateTime  @default(now()) @map("criado_em")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  empresaId      String?   @map("empresa_id") @db.Uuid

  cliente Cliente           @relation(fields: [clienteId], references: [id])
  planos  PlanoManutencao[]

  @@index([clienteId, vigenciaFim])
  @@map("contratos")
}

// ─────────────────────────────────────────
// alerta_config  (configuração dos limiares)
// ─────────────────────────────────────────
model AlertaConfig {
  id                      String @id @default(uuid()) @db.Uuid
  osSemAtualizacaoDias    Int     @default(3)  @map("os_sem_atualizacao_dias")
  equipamentoCorretivasMes Int    @default(3)  @map("equipamento_corretivas_mes")
  contratoVencendoDias    Int     @default(30) @map("contrato_vencendo_dias")
  planoVencendoDias       Int     @default(30) @map("plano_vencendo_dias")
  empresaId               String? @map("empresa_id") @db.Uuid

  @@map("alerta_config")
}

// ─────────────────────────────────────────
// alerta_ocorrencias
// ─────────────────────────────────────────
model AlertaOcorrencia {
  id           String           @id @default(uuid()) @db.Uuid
  tipo         AlertaTipo
  severidade   AlertaSeveridade
  titulo       String           @db.VarChar(255)
  descricao    String           @db.Text
  referenciaId String?          @map("referencia_id") @db.VarChar(255)
  resolvido    Boolean          @default(false)
  criadoEm    DateTime          @default(now()) @map("criado_em")
  resolvidoEm DateTime?         @map("resolvido_em")
  empresaId   String?           @map("empresa_id") @db.Uuid

  @@index([resolvido, criadoEm])
  @@map("alerta_ocorrencias")
}

model AuditoriaConflitoSincronizacao {
  id               String   @id @default(uuid()) @db.Uuid
  ordemServicoId   String   @map("ordem_servico_id") @db.Uuid
  payloadRejeitado Json     @map("payload_rejeitado")
  criadoEm        DateTime @default(now()) @map("criado_em")

  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id])

  @@map("auditoria_conflitos_sincronizacao")
}

// ─────────────────────────────────────────
// orcamentos  (proposta comercial)
// ─────────────────────────────────────────
model Orcamento {
  id           String          @id @default(uuid()) @db.Uuid
  numero       Int             @default(autoincrement())
  status       OrcamentoStatus @default(rascunho)
  titulo       String          @db.VarChar(255)
  validadeDias Int             @default(30) @map("validade_dias")
  observacoes  String?         @db.Text
  tokenPublico String          @unique @default(uuid()) @map("token_publico") @db.Uuid

  clienteId   String   @map("cliente_id") @db.Uuid
  cliente     Cliente  @relation(fields: [clienteId], references: [id])

  // Como a O.S. será gerada quando o orçamento for aprovado
  ambienteId        String? @map("ambiente_id") @db.Uuid
  tipoOs            OsTipo  @default(corretiva) @map("tipo_os")
  tipoServicoId     String? @map("tipo_servico_id") @db.Uuid
  modeloChecklistId String? @map("modelo_checklist_id") @db.Uuid
  // O.S. gerada a partir deste orçamento (preenchida na aprovação)
  ordemServicoId    String? @unique @map("ordem_servico_id") @db.Uuid

  ambiente        Ambiente?        @relation(fields: [ambienteId], references: [id], onDelete: SetNull)
  tipoServico     TipoServico?     @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  modeloChecklist ModeloChecklist? @relation(fields: [modeloChecklistId], references: [id], onDelete: SetNull)
  ordemServico    OrdemServico?    @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  criadoPorId String?  @map("criado_por_id") @db.Uuid
  criadoPor   Usuario? @relation("OrcamentoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  itens        OrcamentoItem[]

  criadoEm    DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  aprovadoEm  DateTime? @map("aprovado_em")
  rejeitadoEm DateTime? @map("rejeitado_em")
  empresaId   String?   @map("empresa_id") @db.Uuid

  @@index([clienteId])
  @@index([status])
  // Numeração sequencial por empresa (contadores_empresa); o default é só um respaldo
  @@unique([empresaId, numero])
  @@map("orcamentos")
}

model OrcamentoItem {
  id            String    @id @default(uuid()) @db.Uuid
  descricao     String    @db.VarChar(255)
  quantidade    Decimal   @default(1) @db.Decimal(10, 3)
  unidade       String    @default("un") @db.VarChar(20)
  precoUnitario Decimal   @map("preco_unitario") @db.Decimal(10, 2)
  // 'servico' (mão de obra) ou 'peca' — alimenta valorMaoObra/valorPecas da O.S. gerada
  categoria     String    @default("servico") @db.VarChar(10)

  orcamentoId String    @map("orcamento_id") @db.Uuid
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@map("orcamento_itens")
}

// ─────────────────────────────────────────
// contadores_empresa  (numeração sequencial por empresa: O.S., orçamentos)
// ─────────────────────────────────────────
model ContadorEmpresa {
  empresaId String @map("empresa_id") @db.Uuid
  nome      String @db.VarChar(40)
  valor     Int    @default(0)

  @@id([empresaId, nome])
  @@map("contadores_empresa")
}

// ─────────────────────────────────────────
// eventos_agenda  (agenda própria do Orbitalis)
// Toda O.S. com data tem um evento (1:1, sincronizado); eventos avulsos
// (reunião, treinamento, lembrete) não têm ordemServicoId.
// inicio/fim são instantes (UTC); a exibição usa America/Sao_Paulo.
// ─────────────────────────────────────────
model EventoAgenda {
  id             String   @id @default(uuid()) @db.Uuid
  empresaId      String?  @map("empresa_id") @db.Uuid
  titulo         String   @db.VarChar(200)
  descricao      String?  @db.Text
  local          String?  @db.Text
  inicio         DateTime
  fim            DateTime
  diaInteiro     Boolean  @default(false) @map("dia_inteiro")
  cor            String?  @db.VarChar(7)
  // true quando alguém editou título/descrição/local à mão: a O.S. deixa de sobrescrevê-los
  personalizado  Boolean  @default(false)
  ordemServicoId String?  @unique @map("ordem_servico_id") @db.Uuid
  tipoServicoId  String?  @map("tipo_servico_id") @db.Uuid
  // Outros tipos de serviço do mesmo evento (ex.: VT + MC); o principal acima define cor e relatórios
  tiposExtrasIds String[] @default([]) @map("tipos_extras_ids") @db.Uuid
  tecnicoId      String?  @map("tecnico_id") @db.Uuid
  clienteId      String?  @map("cliente_id") @db.Uuid
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  ordemServico OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  tipoServico  TipoServico?  @relation(fields: [tipoServicoId], references: [id], onDelete: SetNull)
  tecnico      Usuario?      @relation("EventoTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)
  cliente      Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  @@index([empresaId, inicio])
  @@index([tecnicoId])
  @@map("eventos_agenda")
}


// ─────────────────────────────────────────
// feriados_empresa
// Feriados que a empresa cadastra (municipais, estaduais, recessos próprios).
// Os nacionais não ficam aqui: são calculados pela API. `recorrente` repete todo ano
// no mesmo dia/mês. `origem` deixa espaço para importadores (ex.: 'manual' | 'importado').
// ─────────────────────────────────────────
enum TipoFeriado {
  municipal
  estadual
  personalizado
}

model FeriadoEmpresa {
  id         String      @id @default(uuid()) @db.Uuid
  empresaId  String?     @map("empresa_id") @db.Uuid
  data       DateTime    @db.Date
  nome       String      @db.VarChar(150)
  tipo       TipoFeriado
  recorrente Boolean     @default(false)
  origem     String      @default("manual") @db.VarChar(30)
  criadoEm   DateTime    @default(now()) @map("criado_em")

  @@unique([empresaId, data, nome])
  @@index([empresaId, data])
  @@map("feriados_empresa")
}
