# ── Obrigatórias ─────────────────────────────────────────────
# PostgreSQL (no Railway é injetada automaticamente pelo plugin do banco)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/orbitalis_db?schema=public"

# JWT — a API NÃO sobe sem JWT_SECRET. Gere com: openssl rand -base64 32
JWT_SECRET="troque-por-um-segredo-forte-de-256-bits"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV="development"

# URL pública do front (links de convite, orçamento e e-mails)
FRONTEND_URL="http://localhost:3001"

# ── Opcionais (a funcionalidade fica desativada se faltarem) ─
# E-mail (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="Orbitalis"

# E-mail do admin que recebe os avisos automáticos (cron)
ADMIN_EMAIL=""

# WhatsApp (Evolution API)
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""

# Armazenamento de evidências (AWS S3 ou compatível)
S3_BUCKET_NAME="orbitalis-evidencias"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
